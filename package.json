{
  "name": "pdftoolkit",
  "private": true,
  "version": "0.3.10-rc",
  "type": "module",
  "description": "PDF Toolkit PWA — 100% client-side, MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-tessdata.mjs && tsc --noEmit && vite build",
    "tauri": "tauri",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:web": "playwright test --project=chromium",
    "test:e2e:desktop": "playwright test --project=desktop",
    "gen:fixtures": "node tests/fixtures/gen.mjs"
  },
  "dependencies": {
    "@jsquash/jpeg": "1.6.0",
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/vie": "1.0.0",
    "asn1js": "^3.0.10",
    "comlink": "4.4.2",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-resources-to-backend": "1.2.3",
    "js-pdf-signer": "1.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pkijs": "^3.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-router-dom": "7.1.3",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@napi-rs/canvas": "1.0.10",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "^26.6.4",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "5.1.2",
    "fflate": "^0.8.3",
